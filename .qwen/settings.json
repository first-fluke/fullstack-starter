{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "oma-hook-UserPromptSubmit",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'UserPromptSubmit'",
            "timeout": 21
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "oma-hook-Stop",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'Stop'",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "name": "oma-hook-PreToolUse",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'PreToolUse' --matcher 'run_shell_command'",
            "timeout": 15
          }
        ],
        "matcher": "run_shell_command"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "name": "oma-hook-PostToolUse",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'PostToolUse' --matcher 'write_file|edit|replace'",
            "timeout": 10
          }
        ],
        "matcher": "write_file|edit|replace"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "oma-hook-SessionStart",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'SessionStart'",
            "timeout": 13
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "serena": {
      "command": "oma",
      "args": [
        "bridge",
        "--context",
        "oma"
      ],
      "env": {
        "SERENA_LOG_LEVEL": "info"
      },
      "trust": true
    },
    "aside": {
      "command": "aside",
      "args": [
        "mcp"
      ],
      "trust": true
    }
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "ui": {
    "statusLine": {
      "type": "command",
      "command": "'bun' \"$QWEN_PROJECT_DIR/.qwen/hooks/hud.ts\""
    }
  },
  "$version": 4,
  "hooksConfig": {
    "enabled": true
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(oma *)"
    ]
  }
}
