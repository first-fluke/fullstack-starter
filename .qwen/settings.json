{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "oma-hook-UserPromptSubmit",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'UserPromptSubmit'",
            "timeout": 21
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "oma-hook-Stop",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'Stop'",
            "timeout": 40
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "name": "oma-hook-PreToolUse",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'PreToolUse' --matcher 'run_shell_command|write_file|edit|replace|edit_file'",
            "timeout": 26
          }
        ],
        "matcher": "run_shell_command|write_file|edit|replace|edit_file"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "name": "oma-hook-PostToolUse",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'PostToolUse' --matcher 'write_file|edit|replace|notebook_edit|edit_file'",
            "timeout": 21
          }
        ],
        "matcher": "write_file|edit|replace|notebook_edit|edit_file"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "oma-hook-SessionStart",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'SessionStart'",
            "timeout": 13
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "serena": {
      "command": "oma",
      "args": [
        "bridge",
        "--context",
        "oma"
      ],
      "env": {
        "SERENA_LOG_LEVEL": "info"
      },
      "trust": true
    },
    "aside": {
      "command": "aside",
      "args": [
        "mcp"
      ],
      "trust": true
    }
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "ui": {
    "statusLine": {
      "respectUserColors": true,
      "hideContextIndicator": true,
      "type": "command",
      "command": "'bun' \"$QWEN_PROJECT_DIR/.qwen/hooks/oma/hud.ts\""
    }
  },
  "$version": 4,
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(oma *)"
    ]
  },
  "memory": {
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false
  },
  "general": {
    "gitCoAuthor": {
      "commit": false,
      "pr": false
    }
  },
  "model": {
    "generationConfig": {
      "timeout": 300000
    }
  }
}
