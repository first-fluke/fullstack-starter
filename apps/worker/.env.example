# Project
PROJECT_NAME=fullstack-starter
PROJECT_ENV=local

# Cloud Tasks / Pub/Sub (managed stacks)
GOOGLE_CLOUD_PROJECT=
CLOUD_TASKS_QUEUE=default
CLOUD_TASKS_LOCATION=asia-northeast3

# OIDC verification for /tasks/process (set both in production)
WORKER_VERIFY_OIDC=false
WORKER_OIDC_AUDIENCE=

# In-process cron for the single-VM stack (apps/infra/vm). Leave unset on
# managed stacks; run exactly one worker process when set.
# WORKER_SCHEDULES_FILE=schedules.toml
