# API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Native passkey associations (production signing identities)
MOBILE_ANDROID_PACKAGE_NAME=com.example.mobile
MOBILE_ANDROID_SHA256_CERT_FINGERPRINTS=
# Comma-separated <AppleTeamID>.<bundleIdentifier> values
MOBILE_APPLE_APP_IDS=

# OpenTelemetry (optional - for GCP Cloud Trace)
OTEL_SERVICE_NAME=web
OTEL_SAMPLE_RATE=0.1

# Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
