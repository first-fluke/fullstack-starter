          "status"
        ],
        "title": "HealthResponse"
      },
      "OAuthExchangeRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 256,
            "minLength": 32
          },
          "code_verifier": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
