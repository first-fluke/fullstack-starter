# Project
PROJECT_NAME=fullstack-starter-api
PROJECT_ENV=local

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/app

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# OAuth 2.0 / OpenID Connect
API_PUBLIC_URL=http://localhost:8000
OAUTH_ALLOWED_WEB_ORIGINS=["http://localhost:3000"]
OAUTH_ALLOWED_MOBILE_REDIRECT_URIS=["fullstackstarter://auth/callback"]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# WebAuthn / passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Fullstack Starter
WEBAUTHN_ORIGINS=["http://localhost:3000"]
# Debug/release/Play signing certificate fingerprints; native Android origins
# are derived automatically as android:apk-key-hash:<base64url-sha256>.
WEBAUTHN_ANDROID_SHA256_CERT_FINGERPRINTS=[]

# JWT/JWE (stateless authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWE_SECRET_KEY=your-super-secret-jwe-encryption-key-change-in-production

# Redis (optional)
REDIS_URL=redis://localhost:6379

# OpenTelemetry (optional - for production tracing & metrics)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=fullstack-starter-api

# OpenTelemetry GenAI (LLM observability - OTel GenAI semconv).
# Prompt/completion content is PII-sensitive: "off" records only metadata
# (model, token usage, latency). Set to span_only/event_only/span_and_event to
# capture message content. Auto-enables OTEL_SEMCONV_STABILITY_OPT_IN.
# OTEL_GENAI_CAPTURE_MESSAGE_CONTENT=off

# AI (optional)
AI_PROVIDER=gemini
GOOGLE_CLOUD_PROJECT=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage (optional)
STORAGE_BACKEND=minio
GCS_BUCKET_NAME=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Supabase (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Weaviate (optional)
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Backblaze B2 (optional)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
