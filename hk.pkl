amends "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Config.pkl"

/// Git hooks. Pre-commit lints only the apps touched by staged files and does
/// not rewrite them. Pre-push runs the app suites in order. A failed suite
/// blocks the push. Passes are cached by content in scripts/pre-push.sh.

hooks {
  ["pre-commit"] {
    fix = false
    steps {
      ["api"] {
        glob = "apps/api/**"
        check = "mise //apps/api:lint"
      }
      ["web"] {
        glob = "apps/web/**"
        check = "mise //apps/web:lint"
      }
      ["worker"] {
        glob = "apps/worker/**"
        check = "mise //apps/worker:lint"
      }
      ["mobile"] {
        glob = "apps/mobile/**"
        check = "env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE mise //apps/mobile:lint"
      }
      ["hadolint"] {
        glob = List("**/Dockerfile", "**/Dockerfile.*")
        check = "hadolint {{files}}"
      }
    }
  }
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "./node_modules/.bin/commitlint --edit {{commit_msg_file}}"
      }
    }
  }
  ["pre-push"] {
    fix = false
    stash = "none"
    steps {
      ["branch"] {
        check = "scripts/pre-push.sh gate branch"
      }
      ["api"] {
        depends = "branch"
        check = "scripts/pre-push.sh gate api"
      }
      ["web"] {
        depends = "api"
        check = "scripts/pre-push.sh gate web"
      }
      ["worker"] {
        depends = "web"
        check = "scripts/pre-push.sh gate worker"
      }
      ["mobile"] {
        depends = "worker"
        check = "scripts/pre-push.sh gate mobile"
      }
    }
  }
}
